{
  "permissions": {
    "ask": [
      "Bash(git reset --hard *)",
      "Bash(git reset * --hard *)",
      "Bash(git reset * --hard)",
      "Bash(git checkout -- *)",
      "Bash(git checkout * -- *)",
      "Bash(git checkout .)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git stash)",
      "Bash(git stash -*)",
      "Bash(git stash push *)",
      "Bash(git stash save *)",
      "Bash(git stash pop *)",
      "Bash(git stash apply *)",
      "Bash(git stash drop *)",
      "Bash(git stash clear *)",
      "Bash(git stash branch *)",
      "Bash(git stash store *)",
      "Bash(git branch -D *)",
      "Bash(git branch * -D *)",
      "Bash(git branch --delete --force *)",
      "Bash(git worktree remove *)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git reset * --hard *)",
      "PowerShell(git reset * --hard)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git checkout * -- *)",
      "PowerShell(git checkout .)",
      "PowerShell(git restore *)",
      "PowerShell(git clean *)",
      "PowerShell(git stash)",
      "PowerShell(git stash -*)",
      "PowerShell(git stash push *)",
      "PowerShell(git stash save *)",
      "PowerShell(git stash pop *)",
      "PowerShell(git stash apply *)",
      "PowerShell(git stash drop *)",
      "PowerShell(git stash clear *)",
      "PowerShell(git stash branch *)",
      "PowerShell(git stash store *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch * -D *)",
      "PowerShell(git branch --delete --force *)",
      "PowerShell(git worktree remove *)",
      "PowerShell(git push *)",
      "PowerShell(git commit *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/skills/writing-voice/scripts/prose_lint.py\" --hook",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/code_check.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/notebook_check.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_brief.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_close.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_close.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
