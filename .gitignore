# pdockery/wscc9-illustrative-model: the public seams-workshop sandbox.
# Public documents under sources/ are tracked, the August and October deck
# excerpts under sources/workshops/ among them. Academic sources are link-only:
# their PDFs stay local and each references.bib entry carries the url.

# Transient
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.DS_Store
.venv/
venv/
.env

# Office lock files (~$name.docx, ~$name.pptx)
~$*

# Harness caches (fingerprints, the staleness summary, mypy)
tools/.cache/

# Harness state (2026-11-10): the hook decision log, the session hooks' state and
# the saved workflows' run returns, all local to one machine.
.claude/logs/
.claude/.state/
.claude/workflows/runs/*
!.claude/workflows/runs/README.md

# Notebook exports and scratch copies: the notebook is the source, and its
# stored outputs carry the figures and tables.
outputs/
sandbox_exhibits/
presentation_exhibits/

# Link-only academic sources, kept local
sources/academic-literature/

# Scratch
*.pkl
* - Copy.*
*.bak
